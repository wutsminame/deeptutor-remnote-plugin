+def _remnote_admin_config() -> tuple[str, str]:
+    admin_url = os.environ.get("DEEPTUTOR_REMNOTE_ADMIN_URL", "").strip().rstrip("/")
+    token_file = os.environ.get("DEEPTUTOR_REMNOTE_ADMIN_TOKEN_FILE", "").strip()
+    try:
+        token = Path(token_file).read_text(encoding="utf-8").strip()
+    except OSError:
+        token = ""
+    if not admin_url or len(token) < 20:
+        raise HTTPException(status_code=503, detail="RemNote administration is not configured.")
+    return admin_url, token
+
+
+async def _remnote_admin_request(method: str, path: str, payload: dict | None = None):
+    admin_url, token = _remnote_admin_config()
+    try:
+        async with httpx.AsyncClient(timeout=95, follow_redirects=False) as client:
+            response = await client.request(
+                method,
+                admin_url + path,
+                headers={"Authorization": "Bearer " + token},
+                json=payload,
+            )
+        if response.status_code != 200:
+            raise HTTPException(
+                status_code=502,
+                detail="RemNote administration request failed.",
+            )
+        return response.json()
+    except HTTPException:
+        raise
+    except Exception:
+        logger.exception("RemNote administration request failed")
+        raise HTTPException(status_code=502, detail="RemNote administration request failed.") from None
+
+
+def _deeptutor_embedding_payload() -> dict:
+    from deeptutor.services.config import resolve_embedding_runtime_config
+
+    resolved = resolve_embedding_runtime_config()
+    if not resolved.model or not resolved.api_key or not resolved.effective_url:
+        raise HTTPException(status_code=400, detail="DeepTutor embedding is not configured.")
+    base_url = str(resolved.effective_url).strip().rstrip("/")
+    if base_url.endswith("/embeddings"):
+        base_url = base_url[: -len("/embeddings")]
+    api_key = resolved.api_key
+    if isinstance(api_key, list):
+        api_key = next((str(value).strip() for value in api_key if str(value).strip()), "")
+    if not str(api_key).strip():
+        raise HTTPException(status_code=400, detail="DeepTutor embedding API key is not configured.")
+    return {
+        "provider": "openai",
+        "base_url": base_url,
+        "model_id": resolved.model,
+        "model_name": resolved.model,
+        "api_key": str(api_key),
+        "dimensions": int(resolved.dimension or 0),
+    }
+
+
+@router.get("/knowledge-bases/remnote/embedding")
+async def get_remnote_embedding(_: object = Depends(require_admin)):
+    payload = await _remnote_admin_request("GET", "/admin/embedding")
+    payload["deeptutor_embedding_available"] = True
+    try:
+        resolved = _deeptutor_embedding_payload()
+        payload["deeptutor_model_id"] = resolved["model_id"]
+        payload["deeptutor_dimensions"] = resolved["dimensions"]
+    except HTTPException:
+        payload["deeptutor_embedding_available"] = False
+        payload["deeptutor_model_id"] = ""
+        payload["deeptutor_dimensions"] = 0
+    return payload
+
+
