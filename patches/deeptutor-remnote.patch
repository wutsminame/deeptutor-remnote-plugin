+def test_remnote_embedding_proxy_uses_deeptutor_secret_without_exposing_it(
+    tmp_path, monkeypatch
+) -> None:
+    from deeptutor.api.routers.auth import require_admin
+
+    admin_token_file = tmp_path / "admin-token"
+    admin_token_file.write_text("test-token-<not-a-secret>")
+    monkeypatch.setenv("DEEPTUTOR_REMNOTE_ADMIN_URL", "http://remnote-sync:8081")
+    monkeypatch.setenv("DEEPTUTOR_REMNOTE_ADMIN_TOKEN_FILE", str(admin_token_file))
+
+    class Resolved:
+        model = "qwen3.7-text-embedding"
+        effective_url = "https://example.invalid/compatible-mode/v1/embeddings"
+        base_url = effective_url
+        api_key = "deep-secret-key"
+        dimension = 2560
+        send_dimensions = True
+
+    monkeypatch.setattr(
+        "deeptutor.services.config.resolve_embedding_runtime_config",
+        lambda: Resolved(),
+    )
+    captured = []
+
+    class Response:
+        status_code = 200
+        text = "{}"
+
+        def json(self):
+            return {
+                "enabled": False,
+                "provider": "openai",
+                "base_url": "https://example.invalid/compatible-mode/v1",
+                "model_id": "qwen3.7-text-embedding",
+                "model_name": "qwen3.7-text-embedding",
+                "api_key_set": True,
+                "dimensions": 2560,
+                "revision": "1",
+                "query_prefix": "",
+                "document_prefix": "",
+            }
+
+    class Client:
+        def __init__(self, *args, **kwargs):
+            pass
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *args):
+            pass
+
+        async def request(self, method, url, **kwargs):
+            captured.append((method, url, kwargs))
+            return Response()
+
+    monkeypatch.setattr("deeptutor.api.routers.knowledge.httpx.AsyncClient", Client)
+    app = _build_app()
+    app.dependency_overrides[require_admin] = lambda: object()
+    with TestClient(app) as client:
+        response = client.put(
+            "/api/knowledge-bases/remnote/embedding",
+            json={"enabled": False, "use_deeptutor_embedding": True},
+        )
+    assert response.status_code == 200
+    assert "deep-secret-key" not in response.text
+    method, url, kwargs = captured[0]
