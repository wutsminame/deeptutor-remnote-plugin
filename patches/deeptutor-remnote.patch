diff --git a/web/tests/remnote-knowledge-api.test.ts b/web/tests/remnote-knowledge-api.test.ts
new file mode 100644
index 00000000..c3596644
--- /dev/null
+++ b/web/tests/remnote-knowledge-api.test.ts
@@ -0,0 +1,126 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  connectRemNoteKnowledgeBase,
+  listRemNoteConnections,
+  pairRemNoteKnowledgeBase,
+  testRemNoteEmbedding,
+} from "../features/knowledge/api/catalog";
+
+function jsonResponse(status: number, body: unknown): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+function stubFetch(
+  handler: (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>,
+): () => void {
+  const original = globalThis.fetch;
+  (globalThis as { fetch: typeof fetch }).fetch = handler;
+  return () => {
+    (globalThis as { fetch: typeof fetch }).fetch = original;
+  };
+}
+
+test("RemNote connection catalog returns IDs without credentials", async () => {
+  let request = "";
+  const restore = stubFetch(async (input) => {
+    request = String(input);
+    return jsonResponse(200, { connection_ids: ["personal-remnote"] });
+  });
+  try {
+    assert.deepEqual(await listRemNoteConnections(), ["personal-remnote"]);
+    assert.equal(request, "/api/knowledge-bases/remnote/connections");
+  } finally {
+    restore();
+  }
+});
+
+test("pairing RemNote sends setup fields and returns the one-time sync token", async () => {
+  let body: unknown = null;
+  const restore = stubFetch(async (_input, init) => {
+    body = JSON.parse(String(init?.body));
+    return jsonResponse(200, {
+      status: "connected",
+      name: "My RemNote",
+      connection_id: "personal-remnote",
+      kb_id: "kb-1",
+      service_url: "https://notes.example.com",
+      sync_token: "sync-once",
+    });
+  });
+  try {
+    const result = await pairRemNoteKnowledgeBase({
+      name: "My RemNote",
+      kbId: "kb-1",
+      connectionId: "personal-remnote",
+    });
+    assert.equal(result.sync_token, "sync-once");
+    assert.deepEqual(body, {
+      name: "My RemNote",
+      kb_id: "kb-1",
+      connection_id: "personal-remnote",
+    });
+    assert.equal("read_token" in (body as object), false);
+  } finally {
+    restore();
+  }
+});
+
+test("connecting RemNote sends only the name and opaque connection ID", async () => {
+  const captured: { input: string; body: unknown } = { input: "", body: null };
+  const restore = stubFetch(async (input, init) => {
+    captured.input = String(input);
+    captured.body = JSON.parse(String(init?.body));
+    return jsonResponse(200, {
+      status: "connected",
+      name: "My RemNote",
+      connection_id: "personal-remnote",
+    });
+  });
+  try {
+    await connectRemNoteKnowledgeBase({
+      name: "My RemNote",
+      connectionId: "personal-remnote",
+    });
+    assert.equal(captured.input, "/api/knowledge-bases/connect-remnote");
+    assert.deepEqual(captured.body, {
+      name: "My RemNote",
+      connection_id: "personal-remnote",
+    });
+    assert.equal("url" in (captured.body as object), false);
+    assert.equal("read_token" in (captured.body as object), false);
+  } finally {
+    restore();
+  }
+});
+
+test("testing RemNote with the DeepTutor embedding never sends an API key", async () => {
+  const captured: { input: string; body: unknown } = { input: "", body: null };
+  const restore = stubFetch(async (input, init) => {
+    captured.input = String(input);
+    captured.body = JSON.parse(String(init?.body));
+    return jsonResponse(200, { ok: true, dimensions: 2560 });
+  });
+  try {
+    const result = await testRemNoteEmbedding({
+      use_deeptutor_embedding: true,
+      enabled: false,
+    });
+    assert.equal(result.dimensions, 2560);
+    assert.equal(
+      captured.input,
+      "/api/knowledge-bases/remnote/embedding/test",
+    );
+    assert.deepEqual(captured.body, {
+      use_deeptutor_embedding: true,
+      enabled: false,
+    });
+    assert.equal("api_key" in (captured.body as object), false);
+  } finally {
+    restore();
+  }
+});
diff --git a/web/tests/remnote-knowledge-ui.test.ts b/web/tests/remnote-knowledge-ui.test.ts
