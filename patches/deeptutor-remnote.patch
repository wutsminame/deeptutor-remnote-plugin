+export async function listRemNoteConnections(): Promise<string[]> {
+  const res = await apiFetch(
+    apiUrl("/api/knowledge-bases/remnote/connections"),
+  );
+  if (!res.ok) {
+    throw new Error(
+      await readErrorDetail(res, "Failed to list RemNote connections"),
+    );
+  }
+  const payload = (await res.json()) as { connection_ids?: unknown };
+  return Array.isArray(payload.connection_ids)
+    ? payload.connection_ids.filter(
+        (item): item is string => typeof item === "string",
+      )
+    : [];
+}
+
+export async function connectRemNoteKnowledgeBase(payload: {
+  name: string;
+  connectionId: string;
+}): Promise<{ status: string; name: string; connection_id: string }> {
+  const res = await apiFetch(apiUrl("/api/knowledge-bases/connect-remnote"), {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({
+      name: payload.name,
+      connection_id: payload.connectionId,
+    }),
+  });
+  if (!res.ok) {
+    throw new Error(
+      await readErrorDetail(res, "Failed to connect RemNote knowledge base"),
+    );
+  }
+  invalidateKnowledgeCaches();
+  return (await res.json()) as {
+    status: string;
+    name: string;
+    connection_id: string;
+  };
+}
+
+export interface RemNoteEmbeddingConfig {
+  enabled: boolean;
+  provider: "openai";
+  base_url: string;
+  model_id: string;
+  model_name: string;
+  api_key_set: boolean;
+  dimensions: number;
+  revision: string;
+  query_prefix: string;
+  document_prefix: string;
+  deeptutor_embedding_available: boolean;
+  deeptutor_model_id: string;
+  deeptutor_dimensions: number;
+}
+
+export interface RemNoteEmbeddingUpdate {
+  enabled?: boolean;
+  use_deeptutor_embedding?: boolean;
+  provider?: "openai";
+  base_url?: string;
+  model_id?: string;
+  model_name?: string;
+  api_key?: string | null;
+  clear_api_key?: boolean;
+  dimensions?: number;
+  revision?: string;
+  query_prefix?: string;
+  document_prefix?: string;
+}
+
+export async function getRemNoteEmbeddingConfig(): Promise<RemNoteEmbeddingConfig> {
+  const res = await apiFetch(apiUrl("/api/knowledge-bases/remnote/embedding"));
+  if (!res.ok) {
+    throw new Error(
+      await readErrorDetail(res, "Failed to read RemNote embedding settings"),
+    );
+  }
+  return (await res.json()) as RemNoteEmbeddingConfig;
+}
+
+export async function testRemNoteEmbedding(
+  payload: RemNoteEmbeddingUpdate,
+): Promise<{ ok: boolean; dimensions: number }> {
+  const res = await apiFetch(
+    apiUrl("/api/knowledge-bases/remnote/embedding/test"),
+    {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(payload),
+    },
+  );
+  if (!res.ok) {
+    throw new Error(await readErrorDetail(res, "RemNote embedding test failed"));
+  }
+  return (await res.json()) as { ok: boolean; dimensions: number };
+}
+
+export async function updateRemNoteEmbeddingConfig(
+  payload: RemNoteEmbeddingUpdate,
+): Promise<RemNoteEmbeddingConfig> {
+  const res = await apiFetch(apiUrl("/api/knowledge-bases/remnote/embedding"), {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(payload),
+  });
+  if (!res.ok) {
+    throw new Error(
+      await readErrorDetail(res, "Failed to save RemNote embedding settings"),
+    );
+  }
+  return (await res.json()) as RemNoteEmbeddingConfig;
+}
+
