+@router.post("/knowledge-bases/connect-remnote")
+async def connect_remnote(
+    payload: ConnectRemNoteRequest,
+    _: object = Depends(require_admin),
+):
+    """Register a read-only RemNote KB using a server-owned connection."""
+    name = (payload.name or "").strip()
+    connection_id = (payload.connection_id or "").strip()
+    if not name or not connection_id:
+        raise HTTPException(status_code=400, detail="name and connection_id are required.")
+    try:
+        manager = get_kb_manager()
+        entry = manager.register_remnote_kb(
+            name,
+            connection_id=connection_id,
+            description=(payload.description or "").strip(),
+        )
+        return {
+            "status": "connected",
+            "name": name,
+            "connection_id": entry["connection_id"],
+        }
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from None
+    except HTTPException:
+        raise
+    except Exception:
+        logger.exception("Error connecting RemNote knowledge base")
+        raise HTTPException(status_code=500, detail="Could not connect RemNote knowledge base")
+
+
+@router.post("/knowledge-bases/pair-remnote")
+async def pair_remnote(
+    payload: PairRemNoteRequest,
+    _: object = Depends(require_admin),
+):
+    """Pair a RemNote KB, persist only its read token, return sync token once."""
+    name = (payload.name or "").strip()
+    kb_id = (payload.kb_id or "").strip()
+    connection_id = (payload.connection_id or "").strip()
+    service_url = os.environ.get("DEEPTUTOR_REMNOTE_PUBLIC_URL", "").strip().rstrip("/")
+    if not all((name, kb_id, connection_id)):
+        raise HTTPException(status_code=400, detail="All RemNote setup fields are required.")
+    try:
+        name = validate_knowledge_base_name(name)
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from None
+    if not re.fullmatch(r"[A-Za-z0-9._-]{1,128}", connection_id):
+        raise HTTPException(status_code=400, detail="Invalid RemNote connection ID.")
+    if len(kb_id) > 256 or any(ch in kb_id for ch in "\r\n\0"):
+        raise HTTPException(status_code=400, detail="Invalid RemNote knowledge base ID.")
+    public_url = urlsplit(service_url)
+    if public_url.scheme != "https" or not public_url.hostname:
+        raise HTTPException(status_code=503, detail="RemNote public service URL is not configured.")
+    if public_url.username or public_url.password or public_url.query or public_url.fragment:
+        raise HTTPException(status_code=400, detail="Invalid RemNote plugin service URL.")
+
+    registry_raw = os.environ.get("DEEPTUTOR_REMNOTE_CONNECTIONS", "").strip()
+    admin_url = os.environ.get("DEEPTUTOR_REMNOTE_ADMIN_URL", "").strip().rstrip("/")
+    admin_token_file = os.environ.get("DEEPTUTOR_REMNOTE_ADMIN_TOKEN_FILE", "").strip()
+    try:
+        admin_token = Path(admin_token_file).read_text(encoding="utf-8").strip()
+    except OSError:
+        admin_token = ""
+    if not registry_raw or not admin_url or len(admin_token) < 20:
+        raise HTTPException(status_code=503, detail="RemNote pairing is not configured.")
+    registry_path = Path(registry_raw)
+    try:
+        registry_path.parent.mkdir(parents=True, exist_ok=True)
+        if registry_path.exists():
+            with registry_path.open("a", encoding="utf-8"):
+                pass
+        elif not os.access(registry_path.parent, os.W_OK):
+            raise OSError("connection registry directory is not writable")
+    except OSError:
+        raise HTTPException(status_code=503, detail="RemNote connection registry is not writable.") from None
+
+    if name in get_kb_manager().list_knowledge_bases():
+        raise HTTPException(status_code=409, detail=f"Knowledge base '{name}' already exists.")
+
+    try:
+        async with httpx.AsyncClient(timeout=20, follow_redirects=False) as client:
+            response = await client.post(
+                admin_url + "/admin/pair",
+                headers={"Authorization": "Bearer " + admin_token},
+                json={"kb_id": kb_id},
+            )
+        if response.status_code != 200:
+            raise HTTPException(status_code=502, detail="RemNote pairing service rejected the request.")
+        paired = response.json()
+        sync_token = str(paired.get("sync") or "")
+        read_token = str(paired.get("read") or "")
+        if len(sync_token) < 20 or len(read_token) < 20:
+            raise HTTPException(status_code=502, detail="RemNote pairing service returned invalid credentials.")
+
+        previous = registry_path.read_bytes() if registry_path.exists() else None
+        registry = json.loads(previous.decode("utf-8")) if previous else {}
+        if not isinstance(registry, dict):
+            raise HTTPException(status_code=503, detail="RemNote connection registry is invalid.")
+        registry[connection_id] = {"url": admin_url, "read_token": read_token}
+        atomic_write_json(registry_path, registry)
+        os.chmod(registry_path, 0o600)
+        try:
+            entry = get_kb_manager().register_remnote_kb(
+                name, connection_id=connection_id
+            )
+        except Exception:
+            if previous is None:
+                registry_path.unlink(missing_ok=True)
+            else:
+                registry_path.write_bytes(previous)
+                os.chmod(registry_path, 0o600)
+            raise
+        return {
+            "status": "connected",
+            "name": name,
+            "connection_id": entry["connection_id"],
+            "kb_id": kb_id,
+            "service_url": service_url,
+            "sync_token": sync_token,
+        }
+    except HTTPException:
+        raise
+    except (OSError, ValueError, json.JSONDecodeError):
+        raise HTTPException(status_code=500, detail="Could not store RemNote connection.") from None
+    except Exception:
+        logger.exception("Error pairing RemNote knowledge base")
+        raise HTTPException(status_code=502, detail="Could not pair RemNote knowledge base")
+
