+        connection_id: str,
+        description: str = "",
+    ) -> dict:
+        """Register a read-only external RemNote library.
+
+        Public KB metadata stores only an opaque connection id. The endpoint
+        and read token remain in the administrator-owned connection registry.
+        """
+        from deeptutor.capabilities.remnote.binding import load_connection
