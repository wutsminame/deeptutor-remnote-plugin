+    dimensions: int | None = Field(default=None, ge=0, le=65536)
+    revision: str | None = Field(default=None, max_length=128)
+    query_prefix: str | None = Field(default=None, max_length=1024)
+    document_prefix: str | None = Field(default=None, max_length=1024)
