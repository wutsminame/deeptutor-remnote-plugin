+@router.get("/knowledge-bases/remnote/connections")
+async def list_remnote_connections(_: object = Depends(require_admin)):
+    """List opaque administrator-configured RemNote connection IDs only."""
+    path = os.environ.get("DEEPTUTOR_REMNOTE_CONNECTIONS", "")
+    if not path:
+        return {"connection_ids": []}
+    try:
+        data = json.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        raise HTTPException(status_code=503, detail="RemNote connections are unavailable")
+    if not isinstance(data, dict):
+        raise HTTPException(status_code=503, detail="RemNote connections are unavailable")
+    return {
+        "connection_ids": sorted(
+            str(connection_id)
+            for connection_id, value in data.items()
+            if str(connection_id).strip() and isinstance(value, dict)
+        )
+    }
+
