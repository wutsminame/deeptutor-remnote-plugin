+"""Read-only tools backed by the separately deployed RemNote mirror service."""
+
+from __future__ import annotations
+
+import json
+from urllib.parse import quote
+
+import httpx
+
+from deeptutor.capabilities.remnote.binding import load_connection
+from deeptutor.core.tool_protocol import BaseTool, ToolDefinition, ToolParameter, ToolResult
+
+REMNOTE_TOOL_NAMES = ("remnote_search", "remnote_read", "remnote_navigate", "remnote_status")
+MAX_RESPONSE_BYTES = 2 * 1024 * 1024
+
+
+class _RemNoteTool(BaseTool):
+    async def request(self, kwargs, method, path, **options):
+        try:
+            connection_id = str(kwargs.get("_connection_id") or "")
+            if not connection_id:
+                return ToolResult(content="No RemNote KB selected.", success=False)
+            connection = load_connection(connection_id)
+            async with httpx.AsyncClient(timeout=120, follow_redirects=False) as client:
+                async with client.stream(
+                    method,
+                    connection["url"] + path,
+                    headers={"Authorization": "Bearer " + connection["read_token"]},
+                    **options,
+                ) as response:
+                    if response.status_code != 200:
+                        return ToolResult(
+                            content=f"RemNote service returned HTTP {response.status_code}.",
+                            success=False,
+                        )
+                    encoding = response.headers.get("content-encoding", "identity").lower()
+                    if encoding not in {"", "identity"}:
+                        return ToolResult(
+                            content="Compressed RemNote responses are not accepted.",
+                            success=False,
+                        )
+                    content_length = response.headers.get("content-length")
+                    if content_length and int(content_length) > MAX_RESPONSE_BYTES:
+                        return ToolResult(
+                            content="RemNote response exceeded the safe size limit.",
+                            success=False,
+                        )
+                    if response.is_stream_consumed:
+                        # Mock/in-memory transports may return an already-buffered response.
+                        # No additional copy is needed; production network responses use the
+                        # bounded raw-stream path below.
+                        body = response.content
+                        if len(body) > MAX_RESPONSE_BYTES:
+                            return ToolResult(
+                                content="RemNote response exceeded the safe size limit.",
+                                success=False,
+                            )
+                    else:
+                        body = bytearray()
+                        async for chunk in response.aiter_raw():
+                            if len(chunk) > MAX_RESPONSE_BYTES - len(body):
+                                return ToolResult(
+                                    content="RemNote response exceeded the safe size limit.",
+                                    success=False,
+                                )
+                            body.extend(chunk)
+            payload = json.loads(body)
+            return ToolResult(content=json.dumps(payload, ensure_ascii=False), success=True)
+        except Exception:
+            # Provider exceptions may include private URLs or request headers.
+            return ToolResult(
+                content="RemNote connection unavailable; check the server configuration.",
+                success=False,
+            )
+
+
+class RemNoteSearchTool(_RemNoteTool):
+    def get_definition(self):
+        return ToolDefinition(
+            name="remnote_search",
+            description=(
+                "Search synced RemNote notes, with Rem IDs and citation URLs. "
+                "Uses semantic search when embeddings are enabled, otherwise keyword search."
+            ),
+            parameters=[
+                ToolParameter("query", "string", "Natural-language search question"),
+                ToolParameter("limit", "integer", "Number of Rem results, 1–30", required=False),
+            ],
+        )
+
+    async def execute(self, **kwargs):
+        try:
+            limit = max(1, min(30, int(kwargs.get("limit", 10))))
+        except (ValueError, TypeError):
+            limit = 10
+        return await self.request(
+            kwargs,
+            "POST",
+            "/v1/search",
+            json={"query": str(kwargs.get("query", "")), "limit": limit},
+        )
+
+
+class RemNoteReadTool(_RemNoteTool):
+    def get_definition(self):
+        return ToolDefinition(
+            name="remnote_read",
+            description="Read a full Rem and its parent, child, tag and reference IDs.",
+            parameters=[ToolParameter("rem_id", "string", "Rem ID from search or navigation")],
+        )
+
+    async def execute(self, **kwargs):
+        return await self.request(
+            kwargs, "GET", "/v1/rems/" + quote(str(kwargs.get("rem_id", "")), safe="")
+        )
+
+
+class RemNoteNavigateTool(_RemNoteTool):
+    def get_definition(self):
+        return ToolDefinition(
+            name="remnote_navigate",
+            description=(
+                "Navigate the Rem graph. tagged lists Rems bearing the given tag ID. "
+                "Supports pagination."
+            ),
+            parameters=[
+                ToolParameter("rem_id", "string", "Rem ID"),
+                ToolParameter(
+                    "relation",
+                    "string",
+                    "Relation to follow",
+                    enum=["children", "ancestors", "references", "backlinks", "tagged"],
+                ),
+                ToolParameter("offset", "integer", "Next offset from previous response", required=False),
+            ],
+        )
+
+    async def execute(self, **kwargs):
+        try:
+            offset = max(0, int(kwargs.get("offset", 0)))
+        except (ValueError, TypeError):
+            offset = 0
+        return await self.request(
+            kwargs,
+            "GET",
+            "/v1/rems/" + quote(str(kwargs.get("rem_id", "")), safe="") + "/relations",
+            params={
+                "relation": str(kwargs.get("relation", "children")),
+                "offset": offset,
+                "limit": 50,
+            },
+        )
+
+
+class RemNoteStatusTool(_RemNoteTool):
+    def get_definition(self):
+        return ToolDefinition(
+            name="remnote_status",
+            description="Check the mirror count, pending embeddings and failed embedding jobs.",
+        )
+
+    async def execute(self, **kwargs):
+        return await self.request(kwargs, "GET", "/v1/status")
+
+
+__all__ = [
+    "MAX_RESPONSE_BYTES",
+    "REMNOTE_TOOL_NAMES",
+    "RemNoteNavigateTool",
+    "RemNoteReadTool",
+    "RemNoteSearchTool",
+    "RemNoteStatusTool",
+]
diff --git a/deeptutor/capabilities/remnote/capability.py b/deeptutor/capabilities/remnote/capability.py
