+        entry: dict[str, Any] = {
+            "path": name,
+            "type": REMNOTE_KB_TYPE,
+            "connection_id": connection_id,
+            "description": description or f"RemNote library: {name}",
+            "status": "ready",
+            "needs_reindex": False,
+            "created_at": now,
+            "updated_at": now,
+        }
+        knowledge_bases[name] = entry
+        self._save_config()
+        return entry
