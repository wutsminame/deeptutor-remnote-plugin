diff --git a/deeptutor/capabilities/remnote/binding.py b/deeptutor/capabilities/remnote/binding.py
new file mode 100644
index 00000000..efce39e3
--- /dev/null
+++ b/deeptutor/capabilities/remnote/binding.py
@@ -0,0 +1,89 @@
+"""Resolve a selected RemNote KB to an administrator-owned connection."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from deeptutor.core.context import UnifiedContext
+from deeptutor.knowledge.kb_types import REMNOTE_KB_TYPE
+
+_CACHE_KEY = "_remnote_binding"
+_UNSET = object()
+
+
+def load_connection(connection_id: str) -> dict[str, str]:
+    """Load a private connection without accepting model-controlled endpoints."""
+    path = os.environ.get("DEEPTUTOR_REMNOTE_CONNECTIONS", "")
+    if not path:
+        raise ValueError("DEEPTUTOR_REMNOTE_CONNECTIONS is not configured")
+    data = json.loads(Path(path).read_text(encoding="utf-8"))
+    value = data[connection_id]
+    url = str(value["url"]).rstrip("/")
+    parsed = urlsplit(url)
+    loopback = parsed.hostname in {"127.0.0.1", "localhost", "::1"}
+    private_hosts = {
+        host.strip().lower()
+        for host in os.environ.get("DEEPTUTOR_REMNOTE_PRIVATE_HTTP_HOSTS", "").split(",")
+        if host.strip()
+    }
+    private_http = (
+        parsed.scheme == "http"
+        and os.environ.get("DEEPTUTOR_REMNOTE_ALLOW_PRIVATE_HTTP", "").strip().lower()
+        in {"1", "true", "yes"}
+        and (parsed.hostname or "").lower() in private_hosts
+    )
+    if parsed.scheme != "https" and not (parsed.scheme == "http" and loopback) and not private_http:
+        raise ValueError("RemNote service requires HTTPS or allowlisted private HTTP")
+    if parsed.username or parsed.password or parsed.query or parsed.fragment:
+        raise ValueError("Invalid RemNote service URL")
+    token = str(value["read_token"])
+    if len(token) < 20:
+        raise ValueError("RemNote read token missing")
+    return {"url": url, "read_token": token}
+
+
+def remnote_binding(context: UnifiedContext) -> dict[str, str] | None:
+    """Return the first selected RemNote KB's safe binding metadata."""
+    state = context.extension("remnote")
+    cached = state.get(_CACHE_KEY, _UNSET)
+    if cached is not _UNSET:
+        return cached or None
+
+    from deeptutor.multi_user.knowledge_access import resolve_kb_metadata
+
+    resolved: dict[str, str] | None = None
+    for ref in context.knowledge_bases or []:
+        ref = str(ref).strip()
+        if not ref:
+            continue
+        meta = resolve_kb_metadata(ref)
+        if meta and meta.get("type") == REMNOTE_KB_TYPE:
+            resolved = {
+                "ref": ref,
+                "name": str(meta.get("name") or ref),
+                "connection_id": str(meta.get("connection_id") or ""),
+            }
+            break
+    state[_CACHE_KEY] = resolved or ""
+    return resolved
+
+
+def remnote_kb_refs(context: UnifiedContext) -> set[str]:
+    """Return every selected RemNote KB ref so none enters generic RAG."""
+    from deeptutor.multi_user.knowledge_access import resolve_kb_metadata
+
+    refs: set[str] = set()
+    for ref in context.knowledge_bases or []:
+        ref = str(ref).strip()
+        if not ref:
+            continue
+        meta = resolve_kb_metadata(ref)
+        if meta and meta.get("type") == REMNOTE_KB_TYPE:
+            refs.add(ref)
+    return refs
+
+
+__all__ = ["load_connection", "remnote_binding", "remnote_kb_refs"]
