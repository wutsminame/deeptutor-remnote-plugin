+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import test from "node:test";
+
+const root = process.cwd();
+const read = (relative: string) =>
+  fs.readFileSync(path.join(root, relative), "utf8");
+
+test("Knowledge Center exposes a RemNote external-source card", () => {
+  const source = read("components/knowledge/KnowledgeHome.tsx");
+  assert.match(source, /id: "remnote" as const/);
+  assert.match(source, /metadata\?\.type === "remnote"/);
+  assert.match(source, /Connect RemNote/);
+});
+
+test("link-existing modal pairs RemNote without exposing the read token", () => {
+  const source = read("components/knowledge/CreateKbModal.tsx");
+  assert.match(source, /const REMNOTE_SOURCE = "remnote"/);
+  assert.match(source, /remnoteConnectionIds/);
+  assert.match(source, /onPairRemNote/);
+  assert.match(source, /Knowledge base ID/);
+  assert.match(source, /Connection ID/);
+  assert.match(source, /remnoteName=\{name\}/);
+  assert.match(source, /setRemnoteName=\{setName\}/);
+  assert.match(source, /!linkIsRemNote &&/);
+  assert.match(source, /Enter a knowledge base name to continue\./);
+  assert.match(source, /Sync token/);
+  assert.doesNotMatch(source, /setRemnoteServiceUrl/);
+  assert.doesNotMatch(source, /e\.g\. https:\/\/notes\.example\.com/);
+  assert.doesNotMatch(source, /RemNote read token/);
+  assert.doesNotMatch(source, /RemNote service URL/);
+});
+
+test("Knowledge page wires RemNote connections into the create modal", () => {
+  const source = read("components/knowledge/KnowledgePage.tsx");
+  assert.match(source, /remnoteConnectionIds/);
+  assert.match(source, /connectRemNote/);
+  assert.match(source, /onConnectRemNote=\{connectRemNote\}/);
+  assert.match(source, /onPairRemNote=\{pairRemNote\}/);
+});
+
+test("connected RemNote knowledge bases use their own source identity", () => {
+  const source = read("components/knowledge/KnowledgeEngineIcon.tsx");
+  assert.match(source, /input\.type === "remnote"/);
+});
+
+test("RemNote embedding settings live on the connected KB settings page", () => {
+  const home = read("components/knowledge/KnowledgeHome.tsx");
+  const page = read("components/knowledge/KnowledgePage.tsx");
+  const detail = read("components/knowledge/KnowledgeBaseDetail.tsx");
+  const settings = read("components/knowledge/KbSettingsSection.tsx");
+  const modal = read("components/knowledge/RemNoteEmbeddingSettingsModal.tsx");
+  const client = read("features/knowledge/api/client.ts");
+  assert.doesNotMatch(home, /Embedding settings/);
+  assert.match(detail, /onConfigureRemNoteEmbedding/);
+  assert.match(settings, /kb\.metadata\?\.type === "remnote"/);
+  assert.match(settings, /RemNote retrieval & embedding/);
+  assert.match(settings, /shared by all RemNote knowledge bases/);
+  assert.match(page, /RemNoteEmbeddingSettingsModal/);
+  assert.match(modal, /Enable embedding semantic search/);
+  assert.match(modal, /Use DeepTutor's current embedding configuration/);
+  assert.match(modal, /Test connection/);
+  assert.match(client, /api_key_set/);
+  assert.doesNotMatch(client, /api_key: string;/);
+});
