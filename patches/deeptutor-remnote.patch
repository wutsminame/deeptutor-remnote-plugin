+def test_remnote_connections_are_admin_only_and_secret_free(tmp_path, monkeypatch) -> None:
+    from deeptutor.api.routers.auth import require_admin
+
+    connections = tmp_path / "remnote-connections.json"
+    connections.write_text(
+        json.dumps(
+            {
+                "personal-remnote": {
+                    "url": "https://notes.example.com",
+                    "read_token": "r" * 32,
+                }
+            }
+        )
+    )
+    monkeypatch.setenv("DEEPTUTOR_REMNOTE_CONNECTIONS", str(connections))
+    app = _build_app()
+
+    async def reject_admin():
+        raise HTTPException(status_code=403, detail="Admin access required")
+
+    app.dependency_overrides[require_admin] = reject_admin
+    with TestClient(app) as client:
+        assert client.get("/api/knowledge-bases/remnote/connections").status_code == 403
+
+    app.dependency_overrides[require_admin] = lambda: object()
+    with TestClient(app) as client:
+        response = client.get("/api/knowledge-bases/remnote/connections")
+    assert response.status_code == 200
+    assert response.json() == {"connection_ids": ["personal-remnote"]}
+    serialized = response.text
+    assert "notes.example.com" not in serialized
+    assert "rrrr" not in serialized
+
+
